generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String?   @db.VarChar(150)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  accessProfileId String    @map("access_profile_id") @db.Uuid
  status          String    @default("ACTIVE") @db.VarChar(20)
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  assignedOpportunities     Opportunity[]                      @relation("OpportunityOwner")
  implementationAssignments ImplementationActivityAssignment[]
  accessProfile             AccessProfile                      @relation(fields: [accessProfileId], references: [id])

  @@index([accessProfileId])
  @@map("users")
}

model AccessProfile {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(255)
  description String?  @db.VarChar(255)
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users              User[]
  profilePermissions ProfilePermission[]

  @@map("access_profiles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  module      String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profilePermissions ProfilePermission[]

  @@map("permissions")
}

model ProfilePermission {
  id              String   @id @default(uuid()) @db.Uuid
  accessProfileId String   @map("access_profile_id") @db.Uuid
  permissionId    String   @map("permission_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  accessProfile AccessProfile @relation(fields: [accessProfileId], references: [id])
  permission    Permission    @relation(fields: [permissionId], references: [id])

  @@unique([accessProfileId, permissionId])
  @@index([permissionId])
  @@map("profile_permissions")
}

model Company {
  id            String  @id @default(uuid()) @db.Uuid
  corporateName String? @map("corporate_name") @db.VarChar(255)
  tradeName     String  @map("trade_name") @db.VarChar(255)
  cnpj          String? @unique @db.VarChar(14)

  relationshipStage String @default("CUSTOMER") @map("relationship_stage") @db.VarChar(20)
  status            String @default("ACTIVE") @db.VarChar(20)

  observations String? @db.Text

  addresses       CompanyAddress[]
  contacts        CompanyContact[]
  opportunities   Opportunity[]
  units           Unit[]
  implementations Implementation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([corporateName])
  @@index([tradeName])
  @@index([relationshipStage])
  @@index([status])
  @@map("companies")
}

model CompanyAddress {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  name String @db.VarChar(150)
  type String @default("OTHER") @db.VarChar(30)

  zipCode      String? @map("zip_code") @db.VarChar(8)
  street       String? @db.VarChar(255)
  number       String? @db.VarChar(20)
  complement   String? @db.VarChar(150)
  neighborhood String? @db.VarChar(100)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(2)

  latitude  Float?
  longitude Float?

  isPrimary    Boolean @default(false) @map("is_primary")
  observations String? @db.Text

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([type])
  @@index([city, state])
  @@map("company_addresses")
}

model CompanyContact {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  name      String  @db.VarChar(150)
  role      String? @db.VarChar(100)
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(20)
  whatsapp  String? @db.VarChar(20)
  isPrimary Boolean @default(false) @map("is_primary")

  company Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("company_contacts")
}

model Opportunity {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  ownerId   String? @map("owner_id") @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text

  estimatedValue Decimal? @map("estimated_value") @db.Decimal(14, 2)

  stage  String @default("QUALIFICATION") @db.VarChar(30)
  status String @default("ACTIVE") @db.VarChar(20)

  probability       Int?      @db.SmallInt
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  lostReason String?   @map("lost_reason") @db.Text
  closedAt   DateTime? @map("closed_at")

  company Company @relation(fields: [companyId], references: [id])
  owner   User?   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@index([status])
  @@map("opportunities")
}

model Provider {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(255)
  phone        String? @db.VarChar(20)
  status       String  @default("ACTIVE") @db.VarChar(20)
  observations String? @db.Text

  contacts                ProviderContact[]
  documents               ProviderDocument[]
  connectivities          UnitConnectivity[]
  initialImplementations  Implementation[]       @relation("ImplementationInitialProvider")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@map("providers")
}

model ProviderContact {
  id         String @id @default(uuid()) @db.Uuid
  providerId String @map("provider_id") @db.Uuid

  name      String  @db.VarChar(150)
  role      String? @db.VarChar(100)
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(20)
  isPrimary Boolean @default(false) @map("is_primary")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([providerId])
  @@map("provider_contacts")
}

model ProviderDocument {
  id         String @id @default(uuid()) @db.Uuid
  providerId String @map("provider_id") @db.Uuid

  name         String    @db.VarChar(150)
  type         String?   @db.VarChar(50)
  fileName     String    @map("file_name") @db.VarChar(255)
  storageKey   String    @map("storage_key") @db.VarChar(500)
  mimeType     String?   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int?      @map("size_bytes")
  expiresAt    DateTime? @map("expires_at") @db.Date
  observations String?   @db.Text

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([type])
  @@index([expiresAt])
  @@map("provider_documents")
}

model Unit {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid

  name   String @db.VarChar(255)
  type   String @db.VarChar(100)
  status String @default("ACTIVE") @db.VarChar(20)

  observations String? @db.Text

  company         Company            @relation(fields: [companyId], references: [id])
  address         UnitAddress?
  documents       UnitDocument[]
  connectivities  UnitConnectivity[]
  implementations Implementation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([name])
  @@index([type])
  @@index([status])
  @@map("units")
}

model UnitAddress {
  id     String @id @default(uuid()) @db.Uuid
  unitId String @unique @map("unit_id") @db.Uuid

  zipCode      String? @map("zip_code") @db.VarChar(8)
  street       String? @db.VarChar(255)
  number       String? @db.VarChar(20)
  complement   String? @db.VarChar(150)
  neighborhood String? @db.VarChar(100)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(2)

  areaType String @default("URBAN") @map("area_type") @db.VarChar(20)

  latitude  Float?
  longitude Float?

  observations String? @db.Text

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([city, state])
  @@map("unit_addresses")
}

model UnitDocument {
  id     String @id @default(uuid()) @db.Uuid
  unitId String @map("unit_id") @db.Uuid

  name         String    @db.VarChar(150)
  type         String    @db.VarChar(50)
  fileName     String    @map("file_name") @db.VarChar(255)
  storageKey   String    @map("storage_key") @db.VarChar(500)
  mimeType     String?   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int?      @map("size_bytes")
  expiresAt    DateTime? @map("expires_at") @db.Date
  observations String?   @db.Text

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([type])
  @@index([expiresAt])
  @@map("unit_documents")
}

model UnitConnectivity {
  id         String  @id @default(uuid()) @db.Uuid
  unitId     String  @map("unit_id") @db.Uuid
  providerId String? @map("provider_id") @db.Uuid

  name       String? @db.VarChar(150)
  technology String @db.VarChar(100)

  downloadCapacityMbps Float? @map("download_capacity_mbps")
  uploadCapacityMbps   Float? @map("upload_capacity_mbps")

  responseTimeMs Float? @map("response_time_ms")
  throughputMbps Float? @map("throughput_mbps")
  rxSignalDbm    Float? @map("rx_signal_dbm")

  publicIp  String? @map("public_ip") @db.VarChar(45)
  gatewayIp String? @map("gateway_ip") @db.VarChar(45)
  localIp   String? @map("local_ip") @db.VarChar(45)

  slaPercentage Float? @map("sla_percentage")
  mttrHours     Float? @map("mttr_hours")

  networkName String? @map("network_name") @db.VarChar(150)
  wanIp       String? @map("wan_ip") @db.VarChar(45)

  monitoringEnabled Boolean @default(false) @map("monitoring_enabled")

  serviceStartDate DateTime? @map("service_start_date") @db.Date
  serviceEndDate   DateTime? @map("service_end_date") @db.Date

  status String @default("ACTIVE") @db.VarChar(20)

  observations String? @db.Text

  unit     Unit      @relation(fields: [unitId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // No máximo uma conectividade ACTIVE por unidade
  // (índice único parcial unit_connectivities_one_active_per_unit_idx).
  @@index([unitId])
  @@index([providerId])
  @@index([technology])
  @@index([status])
  @@map("unit_connectivities")
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("template_status")
}

enum ActivityRequirementType {
  EVIDENCE
  FORM
  QUANTITY
  COMMENT
  ENGINEER_APPROVAL
  DAILY_REPORT
  COMPLETION_PERCENTAGE

  @@map("activity_requirement_type")
}

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SINGLE_SELECT
  MULTIPLE_SELECT
  CHECKBOX
  FILE

  @@map("form_field_type")
}

model Template {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(255)
  description String?        @db.Text
  status      TemplateStatus @default(DRAFT)

  stages          TemplateStage[]
  implementations Implementation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@map("templates")
}

model TemplateStage {
  id          String  @id @default(uuid()) @db.Uuid
  templateId  String  @map("template_id") @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text
  order       Int

  template               Template               @relation(fields: [templateId], references: [id], onDelete: Cascade)
  activities             TemplateActivity[]
  implementationStages   ImplementationStage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([templateId, order])
  @@index([templateId])
  @@map("template_stages")
}

model TemplateActivity {
  id          String  @id @default(uuid()) @db.Uuid
  stageId     String  @map("stage_id") @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text
  order       Int

  stage                    TemplateStage              @relation(fields: [stageId], references: [id], onDelete: Cascade)
  requirements             ActivityRequirement[]
  implementationActivities ImplementationActivity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stageId, order])
  @@index([stageId])
  @@map("template_activities")
}

model ActivityRequirement {
  id             String                  @id @default(uuid()) @db.Uuid
  activityId     String                  @map("activity_id") @db.Uuid
  type           ActivityRequirementType
  isRequired     Boolean                 @default(false) @map("is_required")
  order          Int
  configuration  Json?
  formTemplateId String?                 @map("form_template_id") @db.Uuid

  activity                   TemplateActivity                  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  formTemplate               FormTemplate?                     @relation(fields: [formTemplateId], references: [id], onDelete: Restrict)
  evidenceTypes              ActivityRequirementEvidenceType[]
  implementationRequirements ImplementationRequirement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([activityId, order])
  @@index([activityId])
  @@index([formTemplateId])
  @@index([type])
  @@map("activity_requirements")
}

model ActivityRequirementEvidenceType {
  id            String @id @default(uuid()) @db.Uuid
  requirementId String @map("requirement_id") @db.Uuid
  type          String @db.VarChar(50)

  requirement ActivityRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([requirementId, type])
  @@index([requirementId])
  @@map("activity_requirement_evidence_types")
}

model FormTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(255)
  description String? @db.Text
  status      String  @default("ACTIVE") @db.VarChar(20)

  fields                     FormField[]
  requirements               ActivityRequirement[]
  implementationFormSnapshots ImplementationFormSnapshot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@map("form_templates")
}

model FormField {
  id             String        @id @default(uuid()) @db.Uuid
  formTemplateId String        @map("form_template_id") @db.Uuid
  key            String        @db.VarChar(100)
  label          String        @db.VarChar(255)
  description    String?       @db.Text
  type           FormFieldType
  placeholder    String?       @db.VarChar(255)
  isRequired     Boolean       @default(false) @map("is_required")
  order          Int
  options        Json?

  formTemplate             FormTemplate              @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  implementationFormFields ImplementationFormField[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([formTemplateId, key])
  @@unique([formTemplateId, order])
  @@index([formTemplateId])
  @@map("form_fields")
}

enum ImplementationStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("implementation_status")
}

enum ImplementationWorkStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("implementation_work_status")
}

// Distingue quem pode preencher a atividade de quem pode concluí-la.
// A validação dessa autorização entra na conclusão da atividade.
enum ImplementationAssignmentRole {
  EXECUTION
  COMPLETION

  @@map("implementation_assignment_role")
}

// Destinos explícitos em UnitConnectivity. Não aceita coluna arbitrária.
enum ConnectivityFieldTarget {
  PROVIDER_ID
  TECHNOLOGY
  DOWNLOAD_CAPACITY_MBPS
  UPLOAD_CAPACITY_MBPS
  RESPONSE_TIME_MS
  THROUGHPUT_MBPS
  RX_SIGNAL_DBM
  PUBLIC_IP
  GATEWAY_IP
  LOCAL_IP
  WAN_IP
  NETWORK_NAME
  SLA_PERCENTAGE
  MTTR_HOURS
  MONITORING_ENABLED
  SERVICE_START_DATE
  SERVICE_END_DATE
  OBSERVATIONS
  CONNECTIVITY_NAME

  @@map("connectivity_field_target")
}

model Implementation {
  id          String               @id @default(uuid()) @db.Uuid
  unitId      String               @map("unit_id") @db.Uuid
  companyId   String               @map("company_id") @db.Uuid
  templateId  String?              @map("template_id") @db.Uuid
  status      ImplementationStatus @default(IN_PROGRESS)
  startedAt   DateTime             @default(now()) @map("started_at")
  completedAt DateTime?            @map("completed_at")

  templateName        String  @map("template_name") @db.VarChar(255)
  templateDescription String? @map("template_description") @db.Text

  unitName         String @map("unit_name") @db.VarChar(255)
  companyTradeName String @map("company_trade_name") @db.VarChar(255)

  addressZipCode      String? @map("address_zip_code") @db.VarChar(8)
  addressStreet       String? @map("address_street") @db.VarChar(255)
  addressNumber       String? @map("address_number") @db.VarChar(20)
  addressComplement   String? @map("address_complement") @db.VarChar(150)
  addressNeighborhood String? @map("address_neighborhood") @db.VarChar(100)
  addressCity         String? @map("address_city") @db.VarChar(100)
  addressState        String? @map("address_state") @db.VarChar(2)

  initialProviderId   String? @map("initial_provider_id") @db.Uuid
  initialProviderName String? @map("initial_provider_name") @db.VarChar(255)

  unit            Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  template        Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  initialProvider Provider? @relation("ImplementationInitialProvider", fields: [initialProviderId], references: [id], onDelete: SetNull)

  stages        ImplementationStage[]
  formSnapshots ImplementationFormSnapshot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([companyId])
  @@index([templateId])
  @@index([status])
  @@index([initialProviderId])
  @@index([startedAt])
  @@map("implementations")
}

model ImplementationStage {
  id               String                   @id @default(uuid()) @db.Uuid
  implementationId String                   @map("implementation_id") @db.Uuid
  sourceStageId    String?                  @map("source_stage_id") @db.Uuid
  name             String                   @db.VarChar(255)
  description      String?                  @db.Text
  order            Int
  status           ImplementationWorkStatus @default(NOT_STARTED)
  startedAt        DateTime?                @map("started_at")
  completedAt      DateTime?                @map("completed_at")

  implementation Implementation    @relation(fields: [implementationId], references: [id], onDelete: Cascade)
  sourceStage    TemplateStage?    @relation(fields: [sourceStageId], references: [id], onDelete: SetNull)
  activities     ImplementationActivity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([implementationId, order])
  @@index([implementationId])
  @@index([sourceStageId])
  @@map("implementation_stages")
}

model ImplementationActivity {
  id            String                   @id @default(uuid()) @db.Uuid
  stageId       String                   @map("stage_id") @db.Uuid
  sourceActivityId String?               @map("source_activity_id") @db.Uuid
  name          String                   @db.VarChar(255)
  description   String?                  @db.Text
  order         Int
  status        ImplementationWorkStatus @default(NOT_STARTED)
  startedAt     DateTime?                @map("started_at")
  completedAt   DateTime?                @map("completed_at")

  stage        ImplementationStage              @relation(fields: [stageId], references: [id], onDelete: Cascade)
  sourceActivity TemplateActivity?              @relation(fields: [sourceActivityId], references: [id], onDelete: SetNull)
  requirements ImplementationRequirement[]
  assignments  ImplementationActivityAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stageId, order])
  @@index([stageId])
  @@index([sourceActivityId])
  @@map("implementation_activities")
}

model ImplementationActivityAssignment {
  id           String                       @id @default(uuid()) @db.Uuid
  activityId   String                       @map("activity_id") @db.Uuid
  userId       String                       @map("user_id") @db.Uuid
  userName     String                       @map("user_name") @db.VarChar(150)
  role         ImplementationAssignmentRole
  createdAt    DateTime                     @default(now()) @map("created_at")

  activity ImplementationActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([activityId, userId, role])
  @@index([activityId])
  @@index([userId])
  @@map("implementation_activity_assignments")
}

model ImplementationRequirement {
  id                  String                  @id @default(uuid()) @db.Uuid
  activityId          String                  @map("activity_id") @db.Uuid
  sourceRequirementId String?                 @map("source_requirement_id") @db.Uuid
  type                ActivityRequirementType
  isRequired          Boolean                 @default(false) @map("is_required")
  order               Int
  configuration       Json?
  formSnapshotId      String?                 @map("form_snapshot_id") @db.Uuid

  activity          ImplementationActivity                @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sourceRequirement ActivityRequirement?                  @relation(fields: [sourceRequirementId], references: [id], onDelete: SetNull)
  formSnapshot      ImplementationFormSnapshot?           @relation(fields: [formSnapshotId], references: [id], onDelete: SetNull)
  evidenceTypes     ImplementationRequirementEvidenceType[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([activityId, order])
  @@index([activityId])
  @@index([sourceRequirementId])
  @@index([formSnapshotId])
  @@index([type])
  @@map("implementation_requirements")
}

model ImplementationRequirementEvidenceType {
  id            String @id @default(uuid()) @db.Uuid
  requirementId String @map("requirement_id") @db.Uuid
  type          String @db.VarChar(50)

  requirement ImplementationRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([requirementId, type])
  @@index([requirementId])
  @@map("implementation_requirement_evidence_types")
}

model ImplementationFormSnapshot {
  id                   String  @id @default(uuid()) @db.Uuid
  implementationId     String  @map("implementation_id") @db.Uuid
  sourceFormTemplateId String? @map("source_form_template_id") @db.Uuid
  name                 String  @db.VarChar(255)
  description          String? @db.Text
  status               String  @db.VarChar(20)

  implementation     Implementation             @relation(fields: [implementationId], references: [id], onDelete: Cascade)
  sourceFormTemplate FormTemplate?              @relation(fields: [sourceFormTemplateId], references: [id], onDelete: SetNull)
  fields             ImplementationFormField[]
  requirements       ImplementationRequirement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([implementationId, sourceFormTemplateId])
  @@index([implementationId])
  @@index([sourceFormTemplateId])
  @@map("implementation_form_snapshots")
}

model ImplementationFormField {
  id                       String                   @id @default(uuid()) @db.Uuid
  formSnapshotId           String                   @map("form_snapshot_id") @db.Uuid
  sourceFormFieldId        String?                  @map("source_form_field_id") @db.Uuid
  key                      String                   @db.VarChar(100)
  label                    String                   @db.VarChar(255)
  description              String?                  @db.Text
  type                     FormFieldType
  placeholder              String?                  @db.VarChar(255)
  isRequired               Boolean                  @default(false) @map("is_required")
  order                    Int
  options                  Json?
  isSensitive              Boolean                  @default(false) @map("is_sensitive")
  connectivityFieldTarget  ConnectivityFieldTarget? @map("connectivity_field_target")

  formSnapshot    ImplementationFormSnapshot @relation(fields: [formSnapshotId], references: [id], onDelete: Cascade)
  sourceFormField FormField?                 @relation(fields: [sourceFormFieldId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([formSnapshotId, key])
  @@unique([formSnapshotId, order])
  @@index([formSnapshotId])
  @@index([sourceFormFieldId])
  @@map("implementation_form_fields")
}
